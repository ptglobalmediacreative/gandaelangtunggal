# ============================================
# HTACCESS KEAMANAN UNTUK FOLDER ADMIN
# ============================================

# Nonaktifkan directory browsing
Options -Indexes

# Aktifkan mod_rewrite
RewriteEngine On

# ============================================
# 1. BLOKIR AKSES LANGSUNG KE FILE PENTING
# ============================================

# Blokir akses ke file konfigurasi dan auth
<FilesMatch "^(config\.php|auth\.php|header\.php|sidebar\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Blokir file tersembunyi (.htaccess, .env, dll)
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ============================================
# 2. PROTEKSI EKSTENSI BERBAHAYA
# ============================================

<FilesMatch "\.(phar|phtml|php5|php4|php3|inc|bak|sql|log|txt|old|swp|zip|tar|gz)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ============================================
# 3. PROTEKSI SQL INJECTION - DIMODIFIKASI
# ============================================

# Hanya blokir jika query string mengandung pola yang jelas berbahaya
# Tapi izinkan parameter yang diperlukan untuk update produk
RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
# TAMBAHKAN PENGECUALIAN UNTUK PARAMETER UPDATE
RewriteCond %{QUERY_STRING} !(action=edit|action=update|id=[0-9]+) [NC]
RewriteCond %{QUERY_STRING} (select|insert|update|delete|drop|alter|create|union)\s+.*\s+from [NC]
RewriteRule .* - [F,L]

# ============================================
# 4. KEAMANAN HEADER
# ============================================

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================
# 5. SET DEFAULT INDEX
# ============================================

DirectoryIndex dashboard.php login.php index.php

# ============================================
# 6. NONAKTIFKAN ERROR DETAIL
# ============================================

php_flag display_errors off
php_flag display_startup_errors off

# ============================================
# 7. BLOKIR USER AGENT BERBAHAYA
# ============================================

RewriteCond %{HTTP_USER_AGENT} (havij|libwww-perl|wget|curl|python|nikto|scan|masscan|nmap|sqlmap) [NC]
RewriteRule .* - [F,L]

# ============================================
# 8. FILE YANG BOLEH DIAKSES TANPA LOGIN
# ============================================

<FilesMatch "^(login\.php|logout\.php)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# ============================================
# 9. FILE UNTUK PROSES UPDATE PRODUK - DITAMBAHKAN
# ============================================

# Izinkan akses ke file-file yang dibutuhkan untuk update produk
<FilesMatch "^(produk\.php|edit_produk\.php|update_produk\.php|ajax_update\.php|process_update\.php|save_product\.php)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# ============================================
# 10. CEGAH HOTLINKING GAMBAR
# ============================================

<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?gandaelang.co.id [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp|svg|ico)$ - [F,L]
</IfModule>

# ============================================
# 11. KOMPRESI FILE
# ============================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# ============================================
# 12. IZINKAN METHOD POST UNTUK UPDATE
# ============================================

<Limit POST>
    Order Allow,Deny
    Allow from all
</Limit>

# ============================================
# 13. PENGECUALIAN UNTUK FOLDER UPLOAD
# ============================================

# Izinkan akses ke folder uploads untuk gambar produk
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/ - [L]
</IfModule>