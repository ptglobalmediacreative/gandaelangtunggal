# ============================================
# HTACCESS UNTUK WEBSITE ALAT BERAT
# SEO FRIENDLY & OPTIMIZED VERSION
# ============================================

# Mengaktifkan Rewrite Engine
RewriteEngine On

# ============================================
# PENGATURAN SEO DASAR
# ============================================

# Menonaktifkan directory browsing (keamanan)
Options -Indexes

# Mengatur charset default
AddDefaultCharset UTF-8

# ============================================
# CANONICAL URL & REDIRECT (SEO)
# ============================================

# 1. FORCE HTTPS (SEO Priority)
# Uncomment jika sudah punya SSL
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2. FORCE NON-WWW (Pilih salah satu)
# Opsi A: Non-www (lebih disarankan untuk SEO)
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 3. HAPUS SLASH TRAILING (Kecuali untuk root)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# ============================================
# REDIRECT URL LAMA DETAIL PRODUK (PERTAMA!)
# ============================================

# Redirect SPESIFIK untuk wheelloader (double l)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/detailprodukwheelloader\.php\?slug=([^\s&]+) [NC]
RewriteRule ^ /wheelloader/%1? [R=301,L]

# Redirect umum untuk semua detail produk lainnya
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/detailproduk([^/]+)\.php\?slug=([^\s&]+) [NC]
RewriteRule ^ /%1/%2? [R=301,L]

# Redirect /produk/nama-produk/slug ke /nama-produk/slug
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/produk/([^/]+)/([^/\s]+) [NC]
RewriteRule ^ /%1/%2 [R=301,L]

# ============================================
# SEO FRIENDLY REWRITE RULES
# ============================================

# --- HOME PAGE (ROOT) ---
RewriteRule ^$ index.php [L]

# --- STATIC PAGES (Tanpa Parameter) ---
RewriteRule ^about$ about.php [L]
RewriteRule ^aerialplatform$ aerialplatform.php [L]
RewriteRule ^aftersales$ aftersales.php [L]
RewriteRule ^aircompress$ aircompress.php [L]
RewriteRule ^backhoeloader$ backhoeloader.php [L]
RewriteRule ^blog$ blog.php [L]
RewriteRule ^bulldozer$ bulldozer.php [L]
RewriteRule ^coldplaner$ coldplaner.php [L]
RewriteRule ^contact$ contact.php [L]
RewriteRule ^crane$ crane.php [L]
RewriteRule ^excavator$ excavator.php [L]
RewriteRule ^forklift$ forklift.php [L]
RewriteRule ^foundation$ foundation.php [L]
RewriteRule ^halvester$ halvester.php [L]
RewriteRule ^minningtruck$ minningtruck.php [L]
RewriteRule ^motorgrader$ motorgrader.php [L]
RewriteRule ^paver$ paver.php [L]
RewriteRule ^produk$ produk.php [L]
RewriteRule ^roller$ roller.php [L]
RewriteRule ^skidsteer$ skidsteer.php [L]
RewriteRule ^tractor$ tractor.php [L]
RewriteRule ^warehousetruck$ warehousetruck.php [L]
RewriteRule ^wheelloader$ wheelloader.php [L]

# --- BLOG/ARTIKEL ---
RewriteRule ^artikel/([a-zA-Z0-9_-]+)/?$ detail-artikel.php?slug=$1 [L,QSA]

# --- PAGINATION BLOG ---
RewriteRule ^blog/page/([0-9]+)/?$ blog.php?page=$1 [L,QSA]

# ============================================
# DETAIL PRODUK (Format Baru)
# Format: /nama-produk/slug
# ============================================

# Detail produk dengan kategori lengkap
RewriteRule ^aerialplatform/([^/]+)/?$ detailprodukaerialplatform.php?slug=$1 [L,QSA]
RewriteRule ^aircompress/([^/]+)/?$ detailprodukaicompressor.php?slug=$1 [L,QSA]
RewriteRule ^backhoeloader/([^/]+)/?$ detailprodukbackhoeloader.php?slug=$1 [L,QSA]
RewriteRule ^bulldozer/([^/]+)/?$ detailprodukbulldozer.php?slug=$1 [L,QSA]
RewriteRule ^coldplaner/([^/]+)/?$ detailprodukcoldplaner.php?slug=$1 [L,QSA]
RewriteRule ^crane/([^/]+)/?$ detailprodukcrane.php?slug=$1 [L,QSA]
RewriteRule ^excavator/([^/]+)/?$ detailprodukexcavator.php?slug=$1 [L,QSA]
RewriteRule ^forklift/([^/]+)/?$ detailprodukforklift.php?slug=$1 [L,QSA]
RewriteRule ^foundation/([^/]+)/?$ detailprodukfoundation.php?slug=$1 [L,QSA]
RewriteRule ^halvester/([^/]+)/?$ detailprodukhalvester.php?slug=$1 [L,QSA]
RewriteRule ^minningtruck/([^/]+)/?$ detailprodukminningtruck.php?slug=$1 [L,QSA]
RewriteRule ^motorgrader/([^/]+)/?$ detailprodukmotorgrader.php?slug=$1 [L,QSA]
RewriteRule ^paver/([^/]+)/?$ detailprodukpaver.php?slug=$1 [L,QSA]
RewriteRule ^roller/([^/]+)/?$ detailprodukroller.php?slug=$1 [L,QSA]
RewriteRule ^skidsteer/([^/]+)/?$ detailprodukskidsteer.php?slug=$1 [L,QSA]
RewriteRule ^tractor/([^/]+)/?$ detailproduktractor.php?slug=$1 [L,QSA]
RewriteRule ^warehousetruck/([^/]+)/?$ detailprodukwarehousetruck.php?slug=$1 [L,QSA]
RewriteRule ^wheelloader/([^/]+)/?$ detailprodukwheelloader.php?slug=$1 [L,QSA]

# ============================================
# REDIRECT .php KE TANPA .php
# ============================================

# Redirect file .php ke tanpa .php (kecuali file yang sudah di-rewrite)
# TAPI JANGAN redirect detailproduk*.php karena sudah ditangani di atas
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteCond %{REQUEST_URI} !^/detailproduk [NC]
RewriteRule ^ %1 [R=301,L]

# Redirect /index dan /index.php ke root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/index\.php [NC]
RewriteRule ^ %1/ [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/index\s [NC]
RewriteRule ^ %1/ [R=301,L]

# ============================================
# PERBAIKAN UNTUK GAMBAR
# ============================================

# Pastikan gambar, CSS, JS bisa diakses
RewriteCond %{REQUEST_URI} !\.(css|js|jpg|jpeg|png|gif|svg|ico|webp|woff|woff2|ttf|eot|pdf)$ [NC]

# Jangan redirect folder statis
RewriteRule ^images/ - [L]
RewriteRule ^admin/ - [L]
RewriteRule ^css/ - [L]
RewriteRule ^js/ - [L]
RewriteRule ^uploads/ - [L]

# ============================================
# SEO: XML SITEMAP
# ============================================
RewriteRule ^sitemap\.xml$ sitemap-pages.xml [L]
RewriteRule ^sitemap-artikel\.xml$ sitemap-artikel.xml [L]
RewriteRule ^sitemap-produk\.xml$ sitemap-produk.xml [L]

# ============================================
# KEAMANAN
# ============================================

# Proteksi file sensitif
<FilesMatch "\.(env|config|json|lock|md|gitignore|gitattributes|htaccess|htpasswd)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteksi folder admin
<IfModule mod_authz_core.c>
    <Directory "admin">
        Require all denied
    </Directory>
</IfModule>

# ============================================
# PERFORMANCE & CACHING
# ============================================

# Kompresi GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ============================================
# HEADER KEAMANAN
# ============================================

<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer-when-downgrade"
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ============================================
# CUSTOM ERROR PAGES
# ============================================
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php
ErrorDocument 500 /500.php

# ============================================
# FALLBACK 404
# ============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]